pipeline {
    agent any

    tools {
        jdk 'JDK 21'
        maven 'Maven3'
    }

    stages {
        stage('Clone') {
            steps {
                git branch: 'Master',
                    url: 'https://github.com/madhumitha-gitlog/java-cicd-project.git'
            }
        }

        stage('Build') {
            steps {
                sh 'mvn clean package'
            }
        }

        stage('Test') {
            steps {
                sh 'mvn test'
            }
        }

        stage('Archive') {
            steps {
                archiveArtifacts artifacts: 'target/*.jar'
            }
        }
    }

    post {
        success {
            echo 'Java CI/CD Successful'
        }

        failure {
            echo 'Java CI/CD Failed'
        }
    }
}
